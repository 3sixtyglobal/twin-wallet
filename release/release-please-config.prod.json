{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/wallet-models": {
			"package-name": "wallet-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/wallet-connector-entity-storage": {
			"package-name": "wallet-connector-entity-storage",
			"changelog-path": "docs/changelog.md"
		},
		"packages/wallet-connector-iota": {
			"package-name": "wallet-connector-iota",
			"changelog-path": "docs/changelog.md"
		},
		"apps/wallet-cli": {
			"package-name": "wallet-cli",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts",
				"tests/cli.spec.ts"
			]
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"wallet-models",
				"wallet-connector-entity-storage",
				"wallet-connector-iota",
				"wallet-cli"
			]
		}
	]
}
